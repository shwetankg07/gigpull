# --- LLM (pick one provider) -------------------------------------------------
# gemini = free tier via aistudio.google.com, no billing account needed.
# anthropic = console.anthropic.com, paid.
GIGPULL_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GIGPULL_GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=

# --- Local business discovery ------------------------------------------------
# OSM needs no key and no billing. Places needs a Google Cloud project with
# billing enabled; see docs/superpowers/specs for the field-mask cost notes.
GOOGLE_PLACES_API_KEY=

# south,west,north,east — the area OSM is queried over. Default is Bangalore.
GIGPULL_BBOX=12.83,77.45,13.14,77.78
GIGPULL_CITY=Bangalore

# If you are running your own copy, SET THIS to your own project or contact.
# Overpass is a free volunteer service that bans by client identity — leaving
# the default means your traffic is attributed to this repo's author.
GIGPULL_USER_AGENT=

# --- Optional ----------------------------------------------------------------
# Strongest willingness-to-pay signal in local mode. Free, needs a Meta dev app.
META_AD_LIBRARY_TOKEN=
# Only raises rate limits for startup mode.
GITHUB_TOKEN=

GIGPULL_RERANK_TOP_N=30
