# Supabase project — Settings > API. The anon key is the only one the browser
# ever sees, and it is safe there only because row level security is on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string — Settings > Database > Connection pooling.
# Server-side only. Never prefix this NEXT_PUBLIC_.
DATABASE_URL=
